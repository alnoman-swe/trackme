generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  Dev
  QA
  Manager
  Leader
  Admin
}

model Person {
  id       Int     @id @default(autoincrement())
  name     String
  role     Role
  email    String  @default("")
  is_admin Boolean @default(false)
  active   Boolean @default(true)

  entries   Entry[]
  comments  Comment[]  @relation("about")
  authored  Comment[]  @relation("author")
  reactions Reaction[]
  entry_reactions EntryReaction[]

  @@map("people")
}

// What one person got done on one day
model Entry {
  person_id  Int
  day        DateTime @db.Date
  body       String
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  person    Person          @relation(fields: [person_id], references: [id])
  reactions EntryReaction[]

  @@id([person_id, day])
  @@map("entries")
}

// A comment on a person's day (it can exist before they write their entry)
model Comment {
  id         Int      @id @default(autoincrement())
  person_id  Int
  day        DateTime @db.Date
  author_id  Int
  body       String
  created_at DateTime @default(now()) @db.Timestamptz

  person    Person     @relation("about", fields: [person_id], references: [id])
  author    Person     @relation("author", fields: [author_id], references: [id])
  reactions Reaction[]

  @@index([day])
  @@map("comments")
}

// One emoji from one person on one comment. Tapping again removes it.
model Reaction {
  comment_id Int
  person_id  Int
  emoji      String
  created_at DateTime @default(now()) @db.Timestamptz

  comment Comment @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@id([comment_id, person_id, emoji])
  @@map("reactions")
}

// One emoji from one person on someone's entry. Goes away with the entry.
model EntryReaction {
  owner_id   Int
  day        DateTime @db.Date
  person_id  Int
  emoji      String
  created_at DateTime @default(now()) @db.Timestamptz

  entry  Entry  @relation(fields: [owner_id, day], references: [person_id, day], onDelete: Cascade)
  person Person @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@id([owner_id, day, person_id, emoji])
  @@map("entry_reactions")
}

// One row per email batch per day, so nothing is sent twice
model SentEmail {
  day  DateTime @db.Date
  kind String

  @@id([day, kind])
  @@map("sent_emails")
}
