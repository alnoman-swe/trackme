DATABASE_URL=postgres://trackme:trackme@localhost:5433/trackme

# Public address of the app. Used in emails and as the Google sign-in return address.
APP_URL=http://localhost:3000

# Email through Resend (https://resend.com/api-keys). Empty key = emails off.
# MAIL_FROM must use a domain you verified in Resend.
RESEND_API_KEY=
MAIL_FROM=TrackMe <trackme@yourdomain.com>

# Schedule. Days: 0=Sunday ... 6=Saturday. Times are 24h HH:MM in APP_TZ.
# APP_TZ example: Asia/Dhaka. Empty = the server's own timezone.
APP_TZ=
WORK_DAYS=1,2,3,4,5
REMIND_AT=18:00
SUMMARY_AT=20:00

# Google sign-in. See README "Google sign-in" for how to get these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only allow accounts from this Google Workspace domain, e.g. yourcompany.com
GOOGLE_ALLOWED_DOMAIN=
# Comma-separated emails of admins (edit/delete people, get the daily summary)
ADMIN_EMAILS=
# Signs the login cookie. Make one with: openssl rand -base64 32
AUTH_SECRET=
